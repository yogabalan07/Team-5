rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ------------------------------------------------------------------
    // Helpers
    // ------------------------------------------------------------------
    function isSignedIn() {
      return request.auth != null && request.auth.uid != null;
    }

    function isEnabled() {
      return isSignedIn() && request.auth.token.disabled != true;
    }

    function isAdmin() {
      return isEnabled() && request.auth.token.role == 'ADMIN';
    }

    function hasRole(role) {
      return isEnabled() && request.auth.token.role == role;
    }

    function hasAny(roles) {
      return isEnabled() && request.auth.token.role in roles;
    }

    // True when an update touches ONLY the listed fields. Used to let the
    // transactional service flows (sales/billing-clerk, purchase-manager,
    // accounts) adjust derived counters (stock levels, invoice balances, party
    // credit balances) without granting those roles full write access to the
    // master records.
    function changesOnly(fields) {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(fields);
    }

    // ------------------------------------------------------------------
    // users — created/managed ONLY by Cloud Functions. Reads: own profile
    // or admin. Client-side writes are disabled.
    // ------------------------------------------------------------------
    match /users/{userId} {
      allow read: if isEnabled() && (request.auth.uid == userId || isAdmin());
      allow create, update, delete: if false;
    }

    // ------------------------------------------------------------------
    // roles — static roster read by any enabled user; written by admins.
    // ------------------------------------------------------------------
    match /roles/{roleId} {
      allow read: if isEnabled();
      allow create, update, delete: if isAdmin();
    }

    // ------------------------------------------------------------------
    // Master data
    // ------------------------------------------------------------------
    match /customers/{docId} {
      allow read: if isEnabled();
      allow create, update: if hasAny(['ADMIN', 'BILLING_CLERK']) ||
        (hasAny(['ACCOUNTS']) && changesOnly(['creditBalance']));
      allow delete: if isAdmin();
    }

    match /suppliers/{docId} {
      allow read: if isEnabled();
      allow create, update: if hasAny(['ADMIN', 'PURCHASE_MANAGER']) ||
        (hasAny(['ACCOUNTS']) && changesOnly(['creditBalance']));
      allow delete: if isAdmin();
    }

    match /itemBrands/{docId} {
      allow read: if isEnabled();
      allow create, update, delete: if hasAny(['ADMIN', 'STORE_MANAGER']);
    }

    match /itemGroups/{docId} {
      allow read: if isEnabled();
      allow create, update, delete: if hasAny(['ADMIN', 'STORE_MANAGER']);
    }

    match /itemSections/{docId} {
      allow read: if isEnabled();
      allow create, update, delete: if hasAny(['ADMIN', 'STORE_MANAGER']);
    }

    match /units/{docId} {
      allow read: if isEnabled();
      allow create, update, delete: if hasAny(['ADMIN', 'STORE_MANAGER']);
    }

    match /taxes/{docId} {
      allow read: if isEnabled();
      allow create, update, delete: if isAdmin();
    }

    match /items/{docId} {
      allow read: if isEnabled();
      allow create: if hasAny(['ADMIN', 'STORE_MANAGER']);
      // Full item edits stay with admins/store managers; billing clerks and
      // purchase managers may only move stock counters inside the atomic
      // invoice transactions (currentStock + derived flags).
      allow update: if hasAny(['ADMIN', 'STORE_MANAGER']) ||
        (hasAny(['BILLING_CLERK', 'PURCHASE_MANAGER']) &&
          changesOnly(['currentStock', 'isLowStock', 'isOutOfStock', 'updatedAt']));
      allow delete: if isAdmin();
    }

    // ------------------------------------------------------------------
    // Purchases
    // ------------------------------------------------------------------
    match /purchaseOrders/{docId} {
      allow read: if isEnabled();
      allow create, update: if hasAny(['ADMIN', 'PURCHASE_MANAGER']);
      allow delete: if isAdmin();
    }

    match /purchaseInvoices/{docId} {
      allow read: if isEnabled();
      allow create: if hasAny(['ADMIN', 'PURCHASE_MANAGER']);
      allow update: if hasAny(['ADMIN', 'PURCHASE_MANAGER']) ||
        (hasAny(['ACCOUNTS']) && changesOnly(['balanceAmount', 'paymentStatus']));
      allow delete: if isAdmin();
    }

    // ------------------------------------------------------------------
    // Sales
    // ------------------------------------------------------------------
    match /salesInvoices/{docId} {
      allow read: if isEnabled();
      allow create: if hasAny(['ADMIN', 'BILLING_CLERK']);
      allow update: if hasAny(['ADMIN', 'BILLING_CLERK']) ||
        (hasAny(['ACCOUNTS']) && changesOnly(['balanceAmount', 'paymentStatus']));
      allow delete: if isAdmin();
    }

    match /salesReturns/{docId} {
      allow read: if isEnabled();
      allow create, update: if hasAny(['ADMIN', 'BILLING_CLERK']);
      allow delete: if isAdmin();
    }

    match /purchaseReturns/{docId} {
      allow read: if isEnabled();
      allow create, update: if hasAny(['ADMIN', 'PURCHASE_MANAGER']);
      allow delete: if isAdmin();
    }

    // ------------------------------------------------------------------
    // Accounts
    // ------------------------------------------------------------------
    match /billReceipts/{docId} {
      allow read: if isEnabled();
      allow create, update, delete: if hasAny(['ADMIN', 'ACCOUNTS']);
    }

    match /billPayments/{docId} {
      allow read: if isEnabled();
      allow create, update, delete: if hasAny(['ADMIN', 'ACCOUNTS']);
    }

    // ------------------------------------------------------------------
    // Counters — written automatically by transactional services to issue
    // collision-free document numbers. Creates/updates need a signed-in,
    // enabled user; deletes are admin-only.
    // ------------------------------------------------------------------
    match /counters/{counterId} {
      allow read: if isEnabled();
      allow create, update: if isEnabled();
      allow delete: if isAdmin();
    }

    // ------------------------------------------------------------------
    // Stock journal — read by reports; written by transactional services.
    // ------------------------------------------------------------------
    match /stockTransactions/{docId} {
      allow read: if isEnabled();
      allow create: if isEnabled();
      allow update: if false;
      allow delete: if isAdmin();
    }
  }
}