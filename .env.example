# ============================================================
# INVENTORY MANAGEMENT SYSTEM - Environment Variables
# ============================================================
# Copy this file to .env and fill in the values.
# NEVER commit .env to version control.
# ============================================================

# PostgreSQL Database (Neon)
DATABASE_URL=jdbc:postgresql://your-neon-host:5432/your_database?ssl=true&sslmode=require
DATABASE_USERNAME=your_username
DATABASE_PASSWORD=your_password

# JWT Secret (generate a random 256-bit hex string)
# Run: python3 -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=your_jwt_secret_here

# CORS Allowed Origins (comma-separated)
CORS_ALLOWED_ORIGINS=http://localhost:3000
